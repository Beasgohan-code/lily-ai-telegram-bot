# Telegram
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_LOCAL_MODE=true
TELEGRAM_API_BASE=http://127.0.0.1:8081/bot
TELEGRAM_FILE_BASE=http://127.0.0.1:8081/file/bot

# AI provider (OpenAI-compatible)
OPENAI_API_KEY=replace_with_ai_key
OPENAI_API_BASE=https://api.openai.com/v1
# Legacy fallback settings; one base/model can be reused for multiple keys.
LILY_AI_KEYS=primary_key,backup_key_1,backup_key_2
LILY_AI_BASES=https://api.openai.com/v1,https://api.openai.com/v1,https://api.openai.com/v1
LILY_AI_MODELS=gpt-5-mini,gpt-5-nano,gpt-5
LILY_AI_FAMILIES=openai,openai,openai
# Optional advanced profile JSON overrides the legacy settings. Keep this in a secret manager in production.
# LILY_AI_PROFILES_JSON=[{"name":"fast","api_key":"key1","base_url":"https://api.openai.com/v1","model":"gpt-5-mini","family":"openai","capabilities":["chat","structured","reasoning"],"priority":0,"max_retries":1},{"name":"strong","api_key":"key2","base_url":"https://api.anthropic.com/v1","model":"claude-sonnet-4-6","family":"anthropic","capabilities":["chat","structured","reasoning"],"priority":10,"max_retries":1}]
LILY_MODEL_COOLDOWN_BASE=8
LILY_MODEL_COOLDOWN_MAX=300
LILY_AI_REASONING=low

# Curated opt-in fallback presets. Choose a comma-separated order, for example: groq,openrouter-free,ollama.
# Hosted presets are skipped until their own key is set; Ollama runs locally and uses a placeholder key by design.
LILY_AI_PRESETS=groq,openrouter-free,ollama
GROQ_API_KEY=
LILY_GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
LILY_OPENROUTER_FREE_MODEL=openrouter/free
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3:8b
# Anonymous OVH AI is intentionally opt-in and chat-only; use only for non-private, low-volume fallback.
OVH_AI_API_KEY=
LILY_OVH_MODEL=gpt-oss-20b

# Optional web search. DuckDuckGo Instant Answer is the no-key default; replace with a compatible provider if needed.
LILY_WEB_SEARCH_PROVIDER=duckduckgo
LILY_WEB_SEARCH_URL=https://api.duckduckgo.com/
LILY_WEB_SEARCH_API_KEY=
LILY_WEB_SEARCH_MAX_RESULTS=5

# Signed direct streaming links. Put this service behind HTTPS and use the external base URL here.
LILY_STREAM_PUBLIC_BASE_URL=https://lily.example.com
LILY_STREAM_SIGNING_SECRET=replace-with-a-long-random-secret
LILY_STREAM_LINK_TTL=3600
LILY_STREAM_BIND_HOST=127.0.0.1
LILY_STREAM_PORT=8090

# Optional premium/custom emoji ID. Lily falls back to normal text when blank.
LILY_CUSTOM_EMOJI_ID=

# Per-chat defaults for automatic upload naming.
LILY_AUTO_RENAME_ENABLED=false
LILY_AUTO_RENAME_TEMPLATE={title} - S{season:02d}E{episode:02d} - {quality}.{ext}

# Optional provider-neutral media-generation endpoints. A response must include url/output_url.
LILY_IMAGE_GENERATION_URL=
LILY_IMAGE_GENERATION_API_KEY=
LILY_VIDEO_GENERATION_URL=
LILY_VIDEO_GENERATION_API_KEY=
LILY_MEDIA_GENERATION_TIMEOUT=180

# Lily storage and quotas
LILY_DATABASE=data/lily.sqlite3
LILY_WORK_DIR=work
LILY_DOWNLOAD_DIR=downloads
LILY_MAX_FILE_BYTES=1900000000
LILY_MAX_JOB_BYTES=2000000000
LILY_MAX_CONCURRENT_JOBS=2
LILY_CONFIRMATION_TTL=600
LILY_DAILY_REQUEST_LIMIT=100
LILY_MONTHLY_REQUEST_LIMIT=3000
LILY_DAILY_BYTES_LIMIT=2000000000
LILY_MONTHLY_BYTES_LIMIT=25000000000

# Comma-separated Telegram user IDs treated as Lily owners
LILY_ADMIN_USER_IDS=

# Downloads are disabled by default. Use only direct audio URLs and authorized material.
LILY_ALLOW_DIRECT_MEDIA_DOWNLOADS=false
LILY_ALLOWED_DOWNLOAD_DOMAINS=
