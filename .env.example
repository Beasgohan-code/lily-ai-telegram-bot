# Telegram
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_LOCAL_MODE=true
TELEGRAM_API_BASE=http://127.0.0.1:8081/bot
TELEGRAM_FILE_BASE=http://127.0.0.1:8081/file/bot

# AI provider (OpenAI-compatible)
OPENAI_API_KEY=replace_with_ai_key
OPENAI_API_BASE=https://api.openai.com/v1
# Legacy fallback settings; one base/model can be reused for multiple keys.
LILY_AI_KEYS=primary_key,backup_key_1,backup_key_2
LILY_AI_BASES=https://api.openai.com/v1,https://api.openai.com/v1,https://api.openai.com/v1
LILY_AI_MODELS=gpt-5-mini,gpt-5-nano,gpt-5
LILY_AI_FAMILIES=openai,openai,openai
# Optional advanced profile JSON overrides the legacy settings. Keep this in a secret manager in production.
# LILY_AI_PROFILES_JSON=[{"name":"fast","api_key":"key1","base_url":"https://api.openai.com/v1","model":"gpt-5-mini","family":"openai","capabilities":["chat","structured","reasoning"],"priority":0,"max_retries":1},{"name":"strong","api_key":"key2","base_url":"https://api.anthropic.com/v1","model":"claude-sonnet-4-6","family":"anthropic","capabilities":["chat","structured","reasoning"],"priority":10,"max_retries":1}]
LILY_MODEL_COOLDOWN_BASE=8
LILY_MODEL_COOLDOWN_MAX=300
LILY_AI_REASONING=low

# Lily storage and quotas
LILY_DATABASE=data/lily.sqlite3
LILY_WORK_DIR=work
LILY_DOWNLOAD_DIR=downloads
LILY_MAX_FILE_BYTES=1900000000
LILY_MAX_JOB_BYTES=2000000000
LILY_MAX_CONCURRENT_JOBS=2
LILY_CONFIRMATION_TTL=600
LILY_DAILY_REQUEST_LIMIT=100
LILY_MONTHLY_REQUEST_LIMIT=3000
LILY_DAILY_BYTES_LIMIT=2000000000
LILY_MONTHLY_BYTES_LIMIT=25000000000

# Comma-separated Telegram user IDs treated as Lily owners
LILY_ADMIN_USER_IDS=

# Downloads are disabled by default. Use only direct audio URLs and authorized material.
LILY_ALLOW_DIRECT_MEDIA_DOWNLOADS=false
LILY_ALLOWED_DOWNLOAD_DOMAINS=
